# Google Gemini API Key (used for Interactions API & Decisions API)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional defaults
JD_SCREEN_PROVIDER=gemini
JD_SCREEN_MODEL=gemini-4-argon
JD_SCREEN_DECISION_MODEL=models/gemini-decision-1

# Set to 1 to enable opt-in live Gemini evaluation suite (tests/test_live_eval.py)
RUN_LIVE_API_TESTS=0
